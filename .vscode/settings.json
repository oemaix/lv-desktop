{
  "terminal.integrated.defaultProfile.linux": "Nix Develop",
  "terminal.integrated.defaultProfile.osx": "Nix Develop",
  "terminal.integrated.profiles.linux": {
    "Nix Develop": {
      "path": "/bin/sh",
      "args": ["${workspaceFolder}/.vscode/nix-develop-terminal.sh"],
      "overrideName": true
    }
  },
  "terminal.integrated.profiles.osx": {
    "Nix Develop": {
      "path": "/bin/sh",
      "args": ["${workspaceFolder}/.vscode/nix-develop-terminal.sh"],
      "overrideName": true
    }
  }
}
